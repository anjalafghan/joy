DATABASE_URL=sqlite://data/joy.db?mode=rwc
PORT=3000
# 127.0.0.1 to accept only local connections (e.g. behind `tailscale serve`); default 0.0.0.0
HOST=
CURRENCY_SYMBOL=₹
# Home locations as "lat, lng" (Google Maps: long-press your home, copy the coordinates)
PERSON_A=Rohit
HOME_A="19.0760, 72.8777"
PERSON_B=Neha
HOME_B="19.0760, 72.8777"
# Optional neighbourhood names, used in a few slip notes ("Close to …"). Leave unset to keep notes generic.
HOME_A_AREA=
HOME_B_AREA=
# true when served over https
COOKIE_SECURE=false
# `cargo run -- hash-passcode` prints the next two lines
APP_PASSCODE_HASH='...'
SESSION_SECRET=...

# When you meet, so the jar draws for a real date and plans the day (all optional; without
# DATE_DAYS the jar draws for "tonight", as before). Like the homes, these never reach the database.
DATE_DAYS="tue,thu,sat,sun"
# Weeknights start at the office: where it is, its name on the plan, and when you leave it.
OFFICE="19.17, 72.85"
OFFICE_NAME="the office"
WEEKNIGHT_START="19:30"
# Weekend dates: from when you meet until you head home.
WEEKEND_HOURS="11:00-21:00"
# The latest each of you can be somewhere on a weeknight: a place on the way (with its
# "lat, lng" and name), or home when no place is given.
LATEST_A="22:00"
LATEST_A_AT="19.16, 72.85"
LATEST_A_PLACE="the station"
LATEST_B="23:00"
# Your usual home → office trip in minutes, to calibrate travel times; and how you travel
# (train | metro | cab).
COMMUTE_A_MIN=120
COMMUTE_B_MIN=75
TRAVEL_A=train
TRAVEL_B=metro
# The longest either of you will travel one way to a weekend date.
WEEKEND_MAX_TRAVEL_MIN=150
